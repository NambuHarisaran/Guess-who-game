{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.128.0"
    }
  },
  "rewrites": [
    {
      "source": "/game/:id*",
      "destination": "/game/index.html"
    },
    {
      "source": "/display/:target*",
      "destination": "/display/index.html"
    },
    {
      "source": "/dual/:id*",
      "destination": "/dual/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(css|js|uploads|data)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
